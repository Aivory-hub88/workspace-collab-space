# Copy to .env and fill in. Never commit .env (see ../.gitignore).
# No real secrets ship with this repo — only names and local defaults.

# Postgres the engine persists rooms into (see schema.sql).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace_collab

# HS256 secret for user JWTs (any random string; must match the token issuer).
JWT_SECRET=change-me-to-a-random-string

# Shared secret for service/agent peers (dashboard proxy, AI workers).
# Must match on every caller that sends X-Service-Token.
COLLAB_SERVICE_TOKEN=change-me-to-a-random-token

PORT=3200
RUST_LOG=info
