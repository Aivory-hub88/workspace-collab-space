# Copy to .env and fill in. Never commit .env (see ../../.gitignore).

# Postgres for API storage (apply ../collab/schema.sql once).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace

# HS256 secret for user JWTs {user_id|sub, email?, account_type?}.
JWT_SECRET=change-me-to-a-random-string

# Shared secret for service/agent peers (must match the collab engine).
COLLAB_SERVICE_TOKEN=change-me-to-a-random-token

# Collab engine base URL (server-side).
COLLAB_URL=http://localhost:3200

# Public base URLs for login hand-off links.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
